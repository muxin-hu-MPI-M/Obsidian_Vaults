<svg xmlns="http://www.w3.org/2000/svg" width="900" height="800" viewBox="0 0 900 800" role="img" aria-labelledby="title desc">
  <title id="title">Regular triangular prism with triangular top and bottom faces</title>
  <desc id="desc">A schematic regular triangular prism whose top and bottom faces are congruent equilateral triangles, connected by three rectangular side faces.</desc>
  <defs>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="18" stdDeviation="18" flood-color="#0f172a" flood-opacity="0.16"/>
    </filter>
  </defs>

  <rect width="900" height="800" fill="#f8fafc"/>
  <g filter="url(#shadow)">
    <!-- Prism side faces -->
    <polygon points="250,30 650,30 650,390 250,390" fill="#bfdbfe" stroke="#0f172a" stroke-width="3"/>
    <polygon points="650,30 450,376.41 450,736.41 650,390" fill="#93c5fd" stroke="#0f172a" stroke-width="3"/>
    <polygon points="450,376.41 250,30 250,390 450,736.41" fill="#dbeafe" stroke="#0f172a" stroke-width="3"/>

    <!-- Bottom triangular face -->
    <polygon points="250,390 650,390 450,736.41" fill="#fed7aa" fill-opacity="0.72" stroke="#ea580c" stroke-width="4"/>

    <!-- Top triangular face -->
    <polygon points="250,30 650,30 450,376.41" fill="#38bdf8" fill-opacity="0.9" stroke="#0369a1" stroke-width="5"/>

    <!-- Dashed middle layer -->
    <polygon points="250,210 650,210 450,556.41" fill="none" stroke="#7c2d12" stroke-width="5" stroke-dasharray="18 14" stroke-linejoin="round"/>

    <!-- Emphasized vertical prism edges -->
    <line x1="250" y1="30" x2="250" y2="390" stroke="#0f172a" stroke-width="4"/>
    <line x1="650" y1="30" x2="650" y2="390" stroke="#0f172a" stroke-width="4"/>
    <line x1="450" y1="376.41" x2="450" y2="736.41" stroke="#0f172a" stroke-width="4"/>
  </g>
</svg>
